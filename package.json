{
  "name": "righelt",
  "private": true,
  "version": "0.1.0",
  "description": "Righelt web app starter scaffold (Cloudflare free-tier).",
  "scripts": {
    "dev:web": "node scripts/dev-web-auto.mjs 8788",
    "dev:web:a": "node scripts/dev-web-auto.mjs 8789",
    "dev:web:b": "node scripts/dev-web-auto.mjs 8790",
    "dev:web:c": "node scripts/dev-web-auto.mjs 8791",
    "dev:web:auto": "node scripts/dev-web-auto.mjs 8788 --watch-backend",
    "dev:web:a:auto": "node scripts/dev-web-auto.mjs 8789 --watch-backend",
    "dev:web:b:auto": "node scripts/dev-web-auto.mjs 8790 --watch-backend",
    "dev:web:c:auto": "node scripts/dev-web-auto.mjs 8791 --watch-backend",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:engine && pnpm test:api-handler && pnpm test:web",
    "test:engine": "tsx --test $(find packages/game-engine/test -name '*.test.mjs' -type f | sort)",
    "test:engine:unit": "tsx --test $(find packages/game-engine/test/unit -name '*.test.mjs' -type f | sort)",
    "test:engine:integration": "tsx --test $(find packages/game-engine/test/integration -name '*.test.mjs' -type f | sort)",
    "test:api-handler": "tsx --test $(find packages/api-handler/test -name '*.test.mjs' -type f | sort)",
    "test:web": "node --test $(find apps/web/test -name '*.test.mjs' -type f | sort)",
    "cf:set-db": "node scripts/set-d1-binding.mjs",
    "d1:migrate:dev": "pnpm --dir apps/web exec wrangler d1 migrations apply ${CLOUDFLARE_D1_DB_NAME:-righelt-db-dev} --config wrangler.toml",
    "deploy:web": "pnpm --dir apps/web exec wrangler pages deploy . --project-name ${CLOUDFLARE_PAGES_PROJECT:-righelt}",
    "deploy:prod": "pnpm deploy:web"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260215.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "wrangler": "4.67.0"
  }
}
